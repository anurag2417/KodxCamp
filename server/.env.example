# Server config
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas connection string for production)
MONGODB_URI=mongodb://localhost:27017/kodxcamp

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Client URL (for CORS + cookies)
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Email (Gmail SMTP)
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=KodxCamp <no-reply@kodxcamp.dev>
EMAIL_ENABLED=true