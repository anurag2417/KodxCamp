# Server config
NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas connection string for production)
MONGODB_URI=mongodb://localhost:27017/kodxcamp

# Secrets - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Client URL (for CORS + cookies)
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=info

# Public base URL for uploaded recordings (optional - leave empty for local dev)
PUBLIC_UPLOAD_BASE_URL=

# ─── Cloudinary ───────────────────────────────────────────────────
# Media storage. When CLOUDINARY_CLOUD_NAME is set, uploads go to
# Cloudinary instead of the local `uploads/` directory. Leave blank
# in development to keep using the local disk.
#
# Get these from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail SMTP)
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=KodxCamp <no-reply@kodxcamp.dev>
EMAIL_ENABLED=true

# ─── Auth ─────────────────────────────────────────────────
# Pepper mixed into every token hash. A DB leak alone cannot be
# used to brute-force OTPs without this value.
AUTH_PEPPER=replace_with_a_strong_random_string_at_least_32_chars

# Secret for the short-lived "set password after OTP" token.
# Must be different from JWT_SECRET.
SETUP_TOKEN_SECRET=replace_with_a_different_random_string_at_least_32_chars

# ─── Firebase Admin SDK (server-side verification of Google sign-in) ───
# All three must be set, or none. Leave blank to disable Google sign-in.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Razorpay Details
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_MODE=test/live

# ─── AI providers (optional) ─────────────────────────────
# Two evaluators run per project submission, in separate, versioned
# passes:
#
#   TEXT    reviews the student's code against the specification,
#           rubric, and automated test results.
#   VISION  reviews the rendered screenshots against the design and
#           accessibility requirements.
#
# Both passes are independent. Neither overwrites the other, and
# neither overwrites the instructor's score. When a provider is
# not configured, its pass is skipped and the admin UI shows the
# slot as "not configured" — the app boots and functions normally.
#
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=

# Code evaluation. Default model: openai/gpt-oss-120b (text only).
# Set AI_TEXT_PROVIDER=groq to enable. Set to null to disable even
# when GROQ_API_KEY is present.
AI_TEXT_PROVIDER=null
AI_TEXT_MODEL=openai/gpt-oss-120b

# Screenshot evaluation. Default model:
# meta-llama/llama-4-scout-17b-16e-instruct (accepts image input).
# Set AI_VISION_PROVIDER=groq to enable. Set to null to disable.
AI_VISION_PROVIDER=null
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Shared sampling knobs for both passes. Temperature is deliberately
# low: evaluation is a classification task, not a creative one.
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096