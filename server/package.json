{
  "name": "@kodxcamp/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",

    "seed": "tsx src/scripts/seed.ts",
    "seed:force": "tsx src/scripts/seed.ts --force",
    "seed:users": "tsx src/scripts/seed.ts --force --wipe-users",
    "seed:courses": "tsx src/scripts/seed.ts --only=content,accounts,courses",
    "seed:problems": "tsx src/scripts/seed.ts --only=content,accounts,problems",
    "seed:progress": "tsx src/scripts/seed.ts --only=progress",

    "fix:problem-number-index": "tsx src/scripts/drop-problem-number-index.ts",
    "migrate:invitation-roles": "tsx src/scripts/migrate-invitation-roles.ts",

    "make-admin": "tsx src/scripts/make-admin.ts",

    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kodxcamp/shared": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.4.0",
    "groq-sdk": "^0.20.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "razorpay": "^2.9.4",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.9"
  }
}
