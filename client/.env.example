# API base URL. Leave empty to use the Vite dev proxy in development
# (`/api` → http://localhost:5000). In production, set this to the
# deployed server origin, e.g. https://kodxcamp-api.onrender.com
VITE_API_URL=

# ─── Firebase Web SDK (client-side, Google sign-in) ─────────
# Get these from Firebase Console → Project Settings → General →
# Your apps → SDK setup and configuration.
# Leave blank to disable the "Continue with Google" button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to log analytics events to the console in development.
VITE_ANALYTICS_DEBUG=false